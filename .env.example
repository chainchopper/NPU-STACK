# ============================================
# NPU-STACK Environment Configuration (Example)
# Copy this to .env and fill in your values
# ============================================

# ─── Server ──────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ─── Database ────────────────────────────────
DATABASE_URL=sqlite:///data/npu_stack.db

# ─── Model Storage ──────────────────────────
MODEL_STORE_PATH=./data/models
DATASET_CACHE_PATH=./data/datasets
MAX_UPLOAD_SIZE_MB=500

# ─── HuggingFace (for model downloads) ──────
# Get your token from https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
HUGGINGFACE_CACHE_DIR=./data/hf_cache

# ─── Training ───────────────────────────────
DEFAULT_DEVICE=cpu
TORCH_HOME=./data/torch_cache
CUDA_VISIBLE_DEVICES=0

# ─── OpenVINO / NPU ─────────────────────────
OPENVINO_LOG_LEVEL=WARNING
NPU_DEVICE_NAME=NPU

# ─── CORS ────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Logging ────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false

# ─── GGUF / llama.cpp Tools ─────────────────
# Directory where llama.cpp binaries and conversion scripts are stored.
# Defaults to <repo_root>/llama.cpp if not set.
# Override if you want tools stored on a different drive/path.
# LLAMA_CPP_TOOLS_DIR=./llama.cpp

# ─── Branding ───────────────────────────────
APP_NAME=NPU-STACK
APP_VERSION=1.0.0
BRAND=Fanalogy
POWERED_BY=Nirvana

# ─── Shared GitBook Docs Host ───────────────
# One hosted GitBook renderer can serve multiple projects via /url/<published-site>
NPU_STACK_GITBOOK_BASE_URL=http://localhost:3001
NPU_STACK_GITBOOK_CURRENT_PROJECT=npu-stack
# Published target for the current project's public GitBook space/site
NPU_STACK_GITBOOK_NPU_STACK_PUBLISHED_URL=
# Optional JSON registry for multiple projects hosted by the same renderer
# NPU_STACK_GITBOOK_PROJECTS_JSON=[{"id":"npu-stack","title":"NPU-STACK","description":"NPU-STACK docs","published_url":"open-source.gitbook.io/npu-stack","local_root":"gitbook-npu-stack","default":true}]
