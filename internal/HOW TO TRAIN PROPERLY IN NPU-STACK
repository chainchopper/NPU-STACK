#!/bin/bash
set -e

# --- CONFIGURATION PARAMETERS ---
MODEL_DIR="./models/my_fine_tuned_glm5"
MODEL_NAME="distilled-glm5-4bit"
OUTPUT_DIR="./dist"

echo "========================================="
echo "Starting MLC LLM Mobile Compilation Loop"
echo "========================================="

# 1. Quantize weights down to 4-bit Group-Quantization for Mobile VRAM Safety
echo "[STEP 1/3] Executing 4-bit Weight Quantization..."
mlc_llm convert_weight \
    --model $MODEL_DIR \
    --quantization q4f16_1 \
    --output $OUTPUT_DIR/$MODEL_NAME-q4f16_1

# 2. Generate Runtime Compilation Configuration Schemas
echo "[STEP 2/3] Generating Runtime System Configuration Configs..."
mlc_llm gen_config \
    --model $MODEL_DIR \
    --quantization q4f16_1 \
    --output $OUTPUT_DIR/$MODEL_NAME-q4f16_1/params \
    --conv-template gemma_2 \
    --context-window-size 4096

# 3. Compile Model Weights to Target Platform Libraries
echo "[STEP 3/3] Compiling Model Binary Packages..."

# COMPILATION FOR PRECISE TARGET PLATFORMS:
# Execute for iPhone (iOS Deployment via Metal API)
echo "--> Compiling System Library for iOS (Metal)..."
mlc_llm compile \
    --model $OUTPUT_DIR/$MODEL_NAME-q4f16_1/params \
    --device iphone \
    --output $OUTPUT_DIR/$MODEL_NAME-iphone.vulkan.so

# Execute for Android (Android Deployment via Vulkan API)
echo "--> Compiling System Library for Android (Vulkan)..."
mlc_llm compile \
    --model $OUTPUT_DIR/$MODEL_NAME-q4f16_1/params \
    --device android \
    --output $OUTPUT_DIR/$MODEL_NAME-android.tar

echo "========================================="
