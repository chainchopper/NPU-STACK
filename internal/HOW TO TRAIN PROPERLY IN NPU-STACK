pip install pillow

Use code with caution.
Step 2: The Formatting Script
Create a file named format_unsloth_dataset.py and paste the following code:
python

import os
import json
from pathlib import Path
from PIL import Image

def generate_unsloth_jsonl(image_dir, output_jsonl_path, default_prompt=None):
    """
    Scans a directory for images and structures them into an Unsloth-compatible 
    multimodal JSONL format for fine-tuning.
    """
    image_extensions = {'.jpg', '.jpeg', '.png', '.webp'}
    image_directory = Path(image_dir).resolve() # Ensures absolute paths
    dataset_entries = []

    print(f"Scanning directory: {image_directory}")

    # Loop through all files in the directory
    for file_path in image_directory.iterdir():
        if file_path.suffix.lower() in image_extensions:
            # Verify the image is not corrupted
            try:
                with Image.open(file_path) as img:
                    img.verify()
            except Exception as e:
                print(f"Skipping corrupted image {file_path.name}: {e}")
                continue

            # Format the image path explicitly as a file URL for Unsloth
            image_url = f"file://{file_path.as_posix()}"

            # Tailor the prompt or use placeholder instructions
            # Tip: Replace this with your custom prompt logic or match with text files
            prompt_text = default_prompt if default_prompt else f"Analyze and describe this image named {file_path.stem}."
            assistant_response = "PLACEHOLDER: Replace this text with your ground-truth distillation target response."

            # Construct the exact schema required for Unsloth multi-modal chat templates
            entry = {
                "messages": [
                    {
                        "role": "user",
                        "content": [
                            {"type": "image", "image": image_url},
                            {"type": "text", "text": prompt_text}
                        ]
                    },
                    {
                        "role": "assistant",
                        "content": [
                            {"type": "text", "text": assistant_response}
                        ]
                    }
                ]
            }
            dataset_entries = dataset_entries + [entry]

    # Write the entries to a JSONL file
    with open(output_jsonl_path, 'w', encoding='utf-8') as f:
        for entry in dataset_entries:
            f.write(json.dumps(entry, ensure_ascii=False) + '\n')

    print(f"Successfully generated {len(dataset_entries)} entries at: {output_jsonl_path}")

if __name__ == "__main__":
    # --- CONFIGURATION ---
    # Point this to your folder containing training images
    IMAGE_FOLDER = "./training_images" 
    # The final dataset file to pass to Unsloth
    OUTPUT_FILE = "unsloth_multimodal_dataset.jsonl"
    # Optional default query if you aren't loading text dynamically
    DEFAULT_USER_PROMPT = "Describe this image in extreme detail, noting all textures, colors, and objects."

    # Create a dummy folder if it doesn't exist yet for testing
    os.makedirs(IMAGE_FOLDER, exist_ok=True)

    # Run the formatter
    generate_unsloth_jsonl(IMAGE_FOLDER, OUTPUT_FILE, DEFAULT_USER_PROMPT)

